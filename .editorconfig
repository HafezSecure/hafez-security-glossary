root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
# A trailing backslash or two spaces is a hard line break in Markdown.
trim_trailing_whitespace = false

[*.go]
indent_style = tab

[{Makefile,*.mk}]
indent_style = tab
