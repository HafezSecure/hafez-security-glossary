{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hafezsecure.ir/schema/term.schema.json",
  "title": "Hafez Security Glossary term",
  "description": "Front matter of a term file terms/<primary-domain>/<slug>.md. The slug is the file name, not a field. The domain enum is kept in step with schema/domains.json, which the validator treats as authoritative. See docs/architecture/data-model.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["en", "fa", "domains", "status", "definition_fa"],
  "properties": {
    "en": { "type": "string", "minLength": 1 },
    "fa": { "type": "string", "minLength": 1 },
    "domains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["web", "network", "crypto", "forensics", "malware", "cloud", "osint", "appsec"] }
    },
    "status": { "type": "string", "enum": ["draft", "reviewed"] },
    "reviewed_by": { "type": "string" },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["term", "status"],
        "properties": {
          "term": { "type": "string", "minLength": 1 },
          "script": { "type": "string", "enum": ["fa", "latin"] },
          "status": { "type": "string", "enum": ["accepted", "discouraged", "deprecated"] },
          "note": { "type": "string" }
        }
      }
    },
    "definition_fa": { "type": "string", "minLength": 1 },
    "definition_en": { "type": "string" },
    "example_fa": { "type": "string" },
    "see_also": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" } },
    "aliases": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" } },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "url"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "pattern": "^https://" }
        }
      }
    },
    "added": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "reviewed" } } },
      "then": { "required": ["reviewed_by"], "properties": { "reviewed_by": { "type": "string", "minLength": 1 } } }
    }
  ]
}
